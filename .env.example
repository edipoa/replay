# ─── Câmeras ──────────────────────────────────────────────────────────────────
# Câmera 1 (obrigatória)
REPLAY_CAM_1_RTSP_URL=rtsp://192.168.42.1:8080/video
REPLAY_CAM_1_BUFFER_DIR=/tmp/replay_buffer_1

# Câmera 2 (opcional — remova ou deixe em branco para desabilitar)
# REPLAY_CAM_2_RTSP_URL=rtsp://192.168.42.2:8080/video
# REPLAY_CAM_2_BUFFER_DIR=/tmp/replay_buffer_2

# ─── Telegram (obrigatório) ────────────────────────────────────────────────────
# Token do bot Telegram (gerado pelo @BotFather)
REPLAY_BOT_TOKEN=SEU_TOKEN_AQUI

# ID do grupo Telegram (inteiro negativo, ex: -1001234567890)
REPLAY_CHAT_ID=SEU_CHAT_ID_AQUI

# ─── Hardware ─────────────────────────────────────────────────────────────────
# Índice do joystick USB (0 = primeiro dispositivo conectado)
REPLAY_JOYSTICK_ID=0

# Debounce em milissegundos (ignora re-presses rápidos)
REPLAY_DEBOUNCE_MS=2000

# ─── Vídeo ────────────────────────────────────────────────────────────────────
# Duração de cada segmento HLS em segundos (padrão 2)
REPLAY_SEGMENT_TIME_S=2

# ─── Caminhos ─────────────────────────────────────────────────────────────────
REPLAY_OUTPUT_DIR=/tmp/replays
REPLAY_AGENDA_PATH=agenda.json
REPLAY_WATERMARK_PATH=watermark.png

# Música de fundo nos clipes (MP3, AAC, etc.) — deixe em branco para desabilitar
# REPLAY_MUSIC_PATH=/caminho/para/musica.mp3

# Arquivo de log das entregas Telegram (padrão /tmp/telegram.log)
REPLAY_TELEGRAM_LOG=/tmp/telegram.log

# ─── Cloudflare R2 (opcional) ─────────────────────────────────────────────────
# Deixe em branco (ou remova) para desabilitar upload na nuvem
REPLAY_R2_ACCOUNT_ID=
REPLAY_R2_ACCESS_KEY_ID=
REPLAY_R2_SECRET_ACCESS_KEY=
REPLAY_R2_BUCKET=

# Backend PHP (necessário somente quando R2 está habilitado)
REPLAY_BACKEND_URL=https://seusite.com.br
REPLAY_BACKEND_API_KEY=

# ─── Desenvolvimento ──────────────────────────────────────────────────────────
# Ative para simular botão via Enter no terminal (não usa joystick nem GPIO)
# REPLAY_SIMULATE=true
