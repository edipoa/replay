# ─── Câmeras ──────────────────────────────────────────────────────────────────
# Câmera 1 (obrigatória)
REPLAY_CAM_1_RTSP_URL=rtsp://192.168.42.1:8080/video
REPLAY_CAM_1_BUFFER_DIR=/tmp/replay_buffer_1

# Câmera 2 (opcional — remova ou deixe em branco para desabilitar)
# REPLAY_CAM_2_RTSP_URL=rtsp://192.168.42.2:8080/video
# REPLAY_CAM_2_BUFFER_DIR=/tmp/replay_buffer_2

# ─── Telegram ─────────────────────────────────────────────────────────────────
# Token do bot Telegram (gerado pelo @BotFather). Usado pros alertas de operação.
REPLAY_BOT_TOKEN=

# ID do grupo/canal Telegram (inteiro negativo, ex: -1001234567890)
REPLAY_CHAT_ID=

# Entregar cada clipe num tópico do grupo (precisa agenda.json + setup-topics).
# Deixe "false" — os clipes vão pro R2/site; o Telegram é só pros alertas.
REPLAY_TELEGRAM_CLIPS=false

# ─── Hardware ─────────────────────────────────────────────────────────────────
# Índice do joystick USB (0 = primeiro dispositivo conectado)
REPLAY_JOYSTICK_ID=0

# Debounce em milissegundos (ignora re-presses rápidos)
REPLAY_DEBOUNCE_MS=2000

# ─── Vídeo ────────────────────────────────────────────────────────────────────
# Duração de cada segmento HLS em segundos (padrão 2)
REPLAY_SEGMENT_TIME_S=2

# Quanto tempo de segmentos manter em disco (padrão 300 = 5min). Precisa
# sobrar buffer suficiente pra cobrir o pior caso de fila: com o botão
# apertado 2x seguidas, o 2º clipe só começa a coletar segmentos depois que
# o 1º termina de gerar (concat+encode+music, pode levar minutos em hardware
# fraco) — se o buffer for menor que essa espera, o clipe falha com "no
# segments found" ou sai truncado. Aumente se a máquina for mais lenta ainda.
REPLAY_BUFFER_DUR_S=300

# ─── Caminhos ─────────────────────────────────────────────────────────────────
# Não aponte pra tmpfs (ex: /tmp em algumas distros) em máquina com pouca RAM
# — buffer de vídeo + replay.db + clipes pendentes competem com o resto do
# processo pela mesma memória. Use um path em disco persistente.
REPLAY_OUTPUT_DIR=/tmp/replays
REPLAY_AGENDA_PATH=agenda.json
REPLAY_WATERMARK_PATH=watermark.png

# Música de fundo nos clipes (MP3, AAC, etc.) — deixe em branco para desabilitar
# REPLAY_MUSIC_PATH=/caminho/para/musica.mp3

# Arquivo de log das entregas Telegram (padrão /tmp/telegram.log)
REPLAY_TELEGRAM_LOG=/tmp/telegram.log

# ─── Observabilidade ─────────────────────────────────────────────────────────
# Servidor de status HTTP: abra http://<ip-do-notebook>:8088/ no navegador ou
# curl http://<ip>:8088/status | jq  — deixe em branco para desabilitar.
REPLAY_HTTP_ADDR=:8088

# Botão digital de emergência: /botao serve uma página com um botão gigante pro
# celular, pra quando o botão físico falhar no meio do jogo.
# Em branco = sem PIN, /trigger aberto (ok — o onPress já descarta re-press <15s
# e a fila tem cap 1, então o pior caso é um clipe extra de vez em quando).
# Preencha só se quiser exigir um PIN em POST /trigger e na página /botao.
REPLAY_TRIGGER_TOKEN=

# Tópico (message_thread_id) do grupo Telegram onde os alertas críticos são
# postados. 0 = feed principal do grupo (mesmo dos clipes). Os eventos ficam
# sempre gravados em <REPLAY_OUTPUT_DIR>/replay.db, com ou sem Telegram.
REPLAY_ALERT_THREAD_ID=0

# ─── Transmissão ao vivo (opcional) ──────────────────────────────────────────
# Quando ligado, um FFmpeg extra por câmera (só -c copy, sem re-encode) gera um
# HLS quase-vivo servido em /live/<cam>/ e a página do host aovivo.* mostra
# todas as câmeras. Use o SUBSTREAM da câmera (bitrate baixo) pra caber no
# uplink — por padrão a URL da câmera é reaproveitada trocando subtype=0 ->
# subtype=1; defina REPLAY_CAM_<n>_LIVE_RTSP_URL pra sobrescrever.
# REPLAY_LIVE_DIR deve ser um tmpfs pequeno (o HD não aguenta a rotação):
#   tmpfs /tmp/replay_live tmpfs noatime,size=128M,mode=1777 0 0
REPLAY_LIVE_ENABLED=false
REPLAY_LIVE_DIR=/tmp/replay_live
# REPLAY_CAM_1_LIVE_RTSP_URL=
# REPLAY_CAM_2_LIVE_RTSP_URL=

# ─── Cloudflare R2 (opcional) ─────────────────────────────────────────────────
# Deixe em branco (ou remova) para desabilitar upload na nuvem
REPLAY_R2_ACCOUNT_ID=
REPLAY_R2_ACCESS_KEY_ID=
REPLAY_R2_SECRET_ACCESS_KEY=
REPLAY_R2_BUCKET=

# Backend PHP (necessário somente quando R2 está habilitado)
REPLAY_BACKEND_URL=https://seusite.com.br
REPLAY_BACKEND_API_KEY=

# Tempo máximo pra subir cada clipe pro R2 (default 480s). Aumente se a internet
# do campo for muito lenta e você ver "context deadline exceeded" nos eventos.
REPLAY_UPLOAD_TIMEOUT_S=480

# Largura do clipe final em px (default 1280 = 720p). Baixe pra 960 num campo
# com upload fraco — corta ~40% do tamanho do arquivo.
REPLAY_CLIP_WIDTH=1280

# ─── Desenvolvimento ──────────────────────────────────────────────────────────
# Ative para simular botão via Enter no terminal (não usa joystick nem GPIO)
# REPLAY_SIMULATE=true
